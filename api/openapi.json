          }
        },
        "required" : [ "createdAt", "current", "deviceName", "id", "lastUsedAt" ]
      },
      "JoinTableRequest" : {
        "type" : "object",
        "properties" : {
          "buyIn" : {
            "type" : "integer",
            "format" : "int64",
