          },
          "username" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "deviceName", "password", "username" ]
      },
      "OpenTableRequest" : {
        "type" : "object",
        "properties" : {
          "bigBlind" : {
            "type" : "integer",
            "format" : "int64",
